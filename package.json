{
  "name": "festival-playlist-maker",
  "version": "0.1.0",
  "private": true,
  "description": "Makes a Spotify playlist from the lineup of a festival.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc",
    "test:modules": "node --import ./test/support/no-network.ts --test \"test/modules/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:modules && npm run test:e2e"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
